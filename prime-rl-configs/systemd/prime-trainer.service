[Unit]
Description=Prime-RL trainer (GPU1)
After=network-online.target prime-orchestrator@%i.service
Requires=prime-orchestrator@%i.service

[Service]
Type=simple
User=%i
WorkingDirectory=__REMOTE_BASE__/prime-rl
Environment=CUDA_VISIBLE_DEVICES=1
Environment=UV_PROJECT_ENVIRONMENT=__REMOTE_BASE__/prime-rl/.venv
EnvironmentFile=-/etc/prime-rl.env
ExecStart=/usr/bin/env uv run trainer @ __REMOTE_BASE__/configs/hud/rl.train.toml
Restart=always
RestartSec=5
StandardOutput=append:__REMOTE_BASE__/logs/prime-rl/trainer.log
StandardError=append:__REMOTE_BASE__/logs/prime-rl/trainer.err.log

[Install]
WantedBy=multi-user.target

