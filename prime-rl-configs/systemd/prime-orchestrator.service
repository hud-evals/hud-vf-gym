[Unit]
Description=Prime-RL orchestrator (HUD verifiers)
After=network-online.target prime-inference@%i.service
Requires=prime-inference@%i.service

[Service]
Type=simple
User=%i
WorkingDirectory=/workspace/prime-rl
Environment=UV_PROJECT_ENVIRONMENT=/workspace/prime-rl/.venv
EnvironmentFile=-/etc/prime-rl.env
ExecStart=/usr/bin/env uv run orchestrator @ /workspace/configs/hud/orch.toml
Restart=always
RestartSec=5
StandardOutput=append:/var/log/prime-rl/orchestrator.log
StandardError=append:/var/log/prime-rl/orchestrator.err.log

[Install]
WantedBy=multi-user.target

